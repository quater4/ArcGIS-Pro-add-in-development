<UserControl x:Class="XYL_Tools.DataCheckDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0：检查选项 -->
            <RowDefinition Height="*"/>
            <!-- Row 1：图层汇总表 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2：GridSplitter -->
            <RowDefinition Height="*"/>
            <!-- Row 3：错误明细表 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4：底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 检查范围 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="检查范围" FontWeight="Bold" Margin="0,0,0,4" Foreground="#ffffff"/>
            <WrapPanel Orientation="Horizontal">
                <RadioButton Content="所有图层" IsChecked="{Binding CheckOptions.CheckAllLayers}" Margin="0,0,16,0" Foreground="#ffffff"/>
                <RadioButton Content="选中图层" IsChecked="{Binding CheckOptions.CheckSelectedLayers}" Foreground="#ffffff"/>
            </WrapPanel>

            <TextBlock Text="检查规则" FontWeight="Bold" Margin="0,8,0,4" Foreground="#ffffff"/>
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="空值检查" IsChecked="{Binding CheckOptions.CheckNull}" Margin="0,0,16,0" Foreground="#ffffff"        />
                <CheckBox Content="几何检查" IsChecked="{Binding CheckOptions.CheckGeometry}" Margin="0,0,16,0" Foreground="#ffffff"/>
                <CheckBox Content="属性重复检查" IsChecked="{Binding CheckOptions.CheckDuplicate}" Margin="0,0,16,0" Foreground="#ffffff"/>
                <CheckBox Content="空间参考检查" IsChecked="{Binding CheckOptions.CheckSpatialReference}" Foreground="#ffffff"/>
            </WrapPanel>
        </StackPanel>

        <!-- 图层汇总表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding LayerResults}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#F0F0F0"
                  AlternatingRowBackground="#F7F9FC"
                  RowBackground="White"
                  HeadersVisibility="Column"
                  BorderBrush="#CCCCCC"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanUserResizeColumns="False"
                  CanUserSortColumns="True"
                  BorderThickness="1">

            <!-- 表头样式：深蓝背景 + 白色加粗文字 -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                               TextTrimming="None" 
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#9f9f9f"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- 行样式：悬停高亮、选中高亮 -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#BBDEFB"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Width="Auto" Binding="{Binding Status}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Normal">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="Text" Value="✓ 正常"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                    <Setter Property="Foreground" Value="#003333"/>
                                    <Setter Property="Text" Value="⚠ 警告"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="Text" Value="✗ 错误"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="图层" Binding="{Binding LayerName}" Width="Auto"/>
                <DataGridTextColumn Header="类型" Binding="{Binding ShapeType}" Width="Auto"/>
                <DataGridTextColumn Header="要素数" Binding="{Binding FeatureCount}" Width="Auto"/>
                <DataGridTextColumn Header="空间参考" Binding="{Binding SpatialReference}" Width="Auto"/>
                    <DataGridTextColumn Header="字段数" Binding="{Binding FieldCount}" Width="Auto"/>
                    <DataGridTextColumn Header="NULL数" Binding="{Binding NullCount}" Width="Auto"/>
                    <DataGridTextColumn Header="几何错误" Binding="{Binding GeometryErrorCount}" Width="Auto"/>
                    <DataGridTextColumn Header="重复数" Binding="{Binding DuplicateCount}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                  Background="#CCCCCC" ResizeBehavior="PreviousAndNext"/>

        <!-- 错误明细表 -->
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="错误明细" FontWeight="Bold" Margin="0,4,0,4" Foreground="#ffffff" Padding="8,4"/>  
            <DataGrid ItemsSource="{Binding AllIssues}"
                      SelectedItem="{Binding SelectedIssue, UpdateSourceTrigger=PropertyChanged}"
                      MouseDoubleClick="ErrorGrid_MouseDoubleClick"
                      Background="#F0F0F0"
                      RowBackground="White"
                      AlternatingRowBackground="#FFF8E1"
                      HeadersVisibility="Column"
                      BorderBrush="#CCCCCC"
                      VerticalScrollBarVisibility="Auto"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="True"             
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="1">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#9f9f9f"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图层" Binding="{Binding LayerName}" Width="Auto"/>
                    <DataGridTextColumn Header="OID" Binding="{Binding ObjectID}" Width="Auto"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding IssueType}" Width="Auto"/>
                    <DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="Auto"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="定位选中问题" Width="100" Margin="0,0,8,0"
                    Command="{Binding LocateIssueCommand}"/>
            <Button Content="开始检查" Width="80" Margin="0,0,8,0"
                    Command="{Binding CheckCommand}"
                    IsEnabled="{Binding IsNotChecking}"/>
            <Button Content="导出报告" Width="80"
                    Command="{Binding ExportCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
