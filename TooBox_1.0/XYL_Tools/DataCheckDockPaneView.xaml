<UserControl x:Class="XYL_Tools.DataCheckDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Row 0：图层汇总表 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1：GridSplitter -->
            <RowDefinition Height="*"/>
            <!-- Row 2：错误明细表 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3：底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 图层汇总表 -->
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding LayerResults}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="#F0F0F0"
                  AlternatingRowBackground="#F7F9FC"
                  RowBackground="White"
                  HeadersVisibility="Column"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">

            <!-- 表头样式：深蓝背景 + 白色加粗文字 -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                               TextTrimming="None" 
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#2C3E50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- 行样式：悬停高亮、选中高亮 -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#BBDEFB"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Width="Auto" Binding="{Binding Status}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Normal">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Setter Property="Text" Value="✓ 正常"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                    <Setter Property="Foreground" Value="#E65100"/>
                                    <Setter Property="Text" Value="⚠ 警告"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="Text" Value="✗ 错误"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="图层" Binding="{Binding LayerName}" Width="Auto"/>
                <DataGridTextColumn Header="类型" Binding="{Binding ShapeType}" Width="Auto"/>
                <DataGridTextColumn Header="要素数" Binding="{Binding FeatureCount}" Width="Auto"/>
                <DataGridTextColumn Header="空间参考" Binding="{Binding SpatialReference}" Width="Auto"/>
                    <DataGridTextColumn Header="字段数" Binding="{Binding FieldCount}" Width="Auto"/>
                    <DataGridTextColumn Header="NULL数" Binding="{Binding NullCount}" Width="Auto"/>
                    <DataGridTextColumn Header="几何错误" Binding="{Binding GeometryErrorCount}" Width="Auto"/>
                    <DataGridTextColumn Header="重复数" Binding="{Binding DuplicateCount}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                  Background="#CCCCCC" ResizeBehavior="PreviousAndNext"/>

        <!-- 错误明细表 -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="错误明细" FontWeight="Bold" Margin="0,4,0,4" Foreground="#ffffff" Padding="8,4"/>  
            <DataGrid ItemsSource="{Binding AllIssues}"
                      SelectedItem="{Binding SelectedIssue, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      Background="#F0F0F0"
                      RowBackground="White"
                      AlternatingRowBackground="#FFF8E1"
                      HeadersVisibility="Column"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E65100"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="操作" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="定位" Width="50" Height="22"
                                Command="{Binding DataContext.LocateIssueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="图层" Binding="{Binding LayerName}" Width="Auto"/>
                    <DataGridTextColumn Header="OID" Binding="{Binding ObjectID}" Width="60"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding IssueType}" Width="70"/>
                    <DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="80"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="开始检查" Width="80" Margin="0,0,8,0"
                    Command="{Binding CheckCommand}"
                    IsEnabled="{Binding IsNotChecking}"/>
            <Button Content="导出报告" Width="80"
                    Command="{Binding ExportCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
