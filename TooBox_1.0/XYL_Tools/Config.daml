<ArcGIS defaultAssembly="XYL_Tools.dll" defaultNamespace="XYL_Tools" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{2bfb63bf-7950-4548-aabb-dd508bd14d59}" version="1.0" desktopVersion="3.7.1901" product="ArcGISPro">
    <Name>XYL_Tools</Name>
    <Description>XYL_Tools description</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>22234</Author>
    <Company>Acme</Company>
    <Date>2026-08-25 12:14:48</Date>
    <Subject>Framework</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>
  <modules>
    <insertModule id="XYL_Tools_Module" className="Module1" autoLoad="false" caption="Module1">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <!--<tab id="XYL_Tools_Tab1" caption="New Tab">
          <group refID="XYL_Tools_Group1"/>
        </tab>-->
      </tabs>
      <groups>
        <!-- comment this out if you have no controls on the Addin tab to avoid
              an empty group-->
        <group id="XYL_Tools_Group1" caption="测试" appearsOnAddInTab="true">
          <!-- host controls within groups -->
          <button refID="XYL_Tools_Button1" size="large" />
        </group>
      </groups>
      <controls>
        <!-- add your controls here -->
        <button id="XYL_Tools_Button1" caption="图层检查按钮" className="Button1" loadOnClick="true" smallImage="GenericButtonBlue16" largeImage="GenericButtonBlue32">
          <tooltip heading="图层检查">检查图层类型<disabledText /></tooltip>
        </button>
      </controls>
		<dockPanes>
			<dockPane id="XYL_Tools_DataCheckDockPane"
					  caption="GeoTools Pro - 数据质量检查"
					  className="DataCheckDockPaneViewModel"
					  dock="Right"
					  hide="false">
				<content className="DataCheckDockPaneView" />
			</dockPane>
		</dockPanes>
    </insertModule>
  </modules>
</ArcGIS>